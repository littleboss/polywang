# Copy to `.env` locally. Never commit a filled copy.
# Binary Yes/No combo arb is the only default live strategy.

POLYMARKET_LIVE_CONFIRM=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_ALLOWANCE_SPENDER=
POLYMARKET_SETUP_APPROVALS=0
POLYMARKET_KILL_SWITCH=0

MARKET_LIMIT=20
MAX_ORDER_USD=5
MIN_NET_PROFIT_USD=0.05
MIN_RETURN_ON_CAPITAL=0.002
SAFETY_BUFFER_USD=0.02
MERGE_GAS_USD=0
LIVE_MAX_BOOK_LEVELS=1
MAX_BOOK_AGE_SECONDS=5
MARKET_EVENT_LOG=market-events.jsonl

LIVE_ORDER_JOURNAL=live-orders.json
LIVE_DIRECTIONAL_JOURNAL=live-directional.json
LIVE_RISK_STATE_PATH=live-risk.json
LIVE_KILL_SWITCH_PATH=live-kill-switch
LIVE_HEALTH_PATH=live-health.json
LIVE_HEALTH_INTERVAL_SECONDS=5
LIVE_RISK_EQUITY_USD=
LIVE_MAX_TOTAL_EXPOSURE_FRACTION=0.01
LIVE_MAX_MARKET_EXPOSURE_FRACTION=0.01
LIVE_MAX_OPEN_PAIRS=2
LIVE_MAX_OPEN_DIRECTIONAL=2
LIVE_MAX_DAILY_LOSS_USD=5
LIVE_RECONCILIATION_INTERVAL_SECONDS=15
LIVE_FULL_RECOVERY_CYCLES=20
LIVE_CANCEL_ON_SHUTDOWN=1
STALE_ORDER_SECONDS=30
AUTO_MERGE_COMPLETE_SETS=0
AUTO_REDEEM_RESOLVED_POSITIONS=1

CALIBRATION_PATH=calibration.json
CALIBRATION_MIN_SAMPLES=20
ENABLE_CALIBRATION_AUTOTUNE=0

# Sports / macro / crypto stay observational unless both execution and live flags are set.
ENABLE_SPORTS_CHANNEL=1
ENABLE_SPORTS_EXECUTION=0
ENABLE_SPORTS_LIVE=0
SPORTS_MARKET_MAP=
SPORTS_MIN_EDGE=0.03

MACRO_FEED_PATH=
MACRO_MARKET_MAP=
MACRO_MIN_EDGE=0.03
ENABLE_MACRO_EXECUTION=0
ENABLE_MACRO_LIVE=0
MACRO_POLL_SECONDS=2

CRYPTO_REFERENCE_FEED_PATH=
ENABLE_CRYPTO_EXECUTION=0
ENABLE_CRYPTO_LIVE=0
CRYPTO_POLL_SECONDS=2
